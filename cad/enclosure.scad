// Companion model. Regenerate generated_parameters.scad after editing parameters.json.
// OpenSCAD was not installed/executed for this release. Use verified CadQuery STEP/STL.
include <generated_parameters.scad>
$fn=96;
part="assembly"; // base, lid, pcb, fixture, assembly, exploded
module rr(l,w,h,r){linear_extrude(h) hull() for(x=[r,l-r],y=[r,w-r]) translate([x,y]) circle(r);}
module hole(x,y,z,r,h){translate([x,y,z]) cylinder(r=r,h=h);}
module base(){difference(){union(){difference(){rr(length,width,body,corner_radius);translate([0,0,floor]) linear_extrude(body) polygon(pocket_outline);}for(p=pcb_holes) hole(p[0],p[1],floor,support_radius,support_height);}for(p=lid_holes)hole(p[0],p[1],body-7,lid_tap_drill/2,8);for(p=pcb_holes)hole(p[0],p[1],board_z-4,pcb_tap_drill/2,4.5);for(p=mounts)hole(p[0],p[1],-1,mount_hole_diameter/2,floor+2);translate([connector_x,wall+1,connector_bottom]) rotate([90,0,0])rr(connector_width,connector_height,wall+2,connector_radius);}}
module lid(){difference(){union(){translate([0,0,body])rr(length,width,lid_thickness,corner_radius);translate([(length-sink_length)/2,(width-sink_width)/2,ped_z])rr(sink_length,sink_width,body-ped_z,3);for(i=[0:fin_count-1])translate([(length-sink_length)/2+i*(sink_length-fin_thickness)/(fin_count-1),(width-sink_width)/2,body+lid_thickness])cube([fin_thickness,sink_width,fin_height]);}for(p=concat(lid_holes,fan_holes))hole(p[0],p[1],body-1,lid_screw_clearance/2,4);}}
module pcb(){difference(){translate([board_x,board_y,board_z])cube([board_length,board_width,board_thickness]);for(p=pcb_holes)hole(p[0],p[1],board_z-1,board_hole_diameter/2,4);}}
module screw(x,y,z,r,len,hr,hh){hole(x,y,z-len,r,len);hole(x,y,z,hr,hh);}
module fan(){difference(){translate([(length-fan_size)/2,(width-fan_size)/2,height])cube([fan_size,fan_size,fan_height]);hole(length/2,width/2,height-1,fan_size/2-3,fan_height+2);for(p=fan_holes)hole(p[0],p[1],height-1,1.7,fan_height+2);}for(p=fan_holes)difference(){hole(p[0],p[1],body+lid_thickness,3,fin_height);hole(p[0],p[1],body+lid_thickness-1,1.7,fin_height+2);}}
module fixture(){points=[[18,12],[length-18,12],[length/2,width-12],[20,-3],[length-20,-3],[-3,width/2]];difference(){translate([-15,-15,-10])rr(length+30,width+30,6,3);for(p=points)hole(p[0],p[1],-11,1.65,8);}for(i=[0:5]){p=points[i];hole(p[0],p[1],-4,3,i<3?4:9);hole(p[0],p[1],-14,1.5,10);}}
module assembly(e=0){color("silver")base();translate([0,0,e]){color("seagreen")pcb();color("dimgray")translate([(length-chip_length)/2,(width-chip_width)/2,chip_z])cube([chip_length,chip_width,chip_height]);color("orange")translate([(length-chip_length)/2,(width-chip_width)/2,pad_z])cube([chip_length,chip_width,pad_compressed]);color("slategray")translate([connector_x+.75,-2,connector_bottom+.75])cube([connector_width-1.5,board_y+2,connector_height-1.5]);color("gray")translate([board_x+board_length-20,width/2-9,chip_z])cube([12,18,component_height]);for(p=pcb_holes)color("gray")screw(p[0],p[1],chip_z,.95,5,2.25,1.7);}translate([0,0,2*e]){color("lightsteelblue")lid();for(p=lid_holes)color("gray")screw(p[0],p[1],body+lid_thickness,1.2,8,2.75,2);if(fan_enabled)color("dimgray")fan();}}
if(part=="base")base();else if(part=="lid")lid();else if(part=="pcb")pcb();else if(part=="fixture")fixture();else assembly(part=="exploded"?16:0);
